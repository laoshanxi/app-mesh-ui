# Throttle the OIDC token endpoint only (it is the endpoint that verifies
# passwords). 1r/s with a small burst keeps browser login (one call per login)
# and CLI token refresh well inside the limit while slowing password spraying.
# Zone lives at http level; conf.d is included there.
limit_req_zone $binary_remote_addr zone=auth_token:10m rate=1r/s;

# CORS headers for /appmesh/ are gated on the same-origin $cors_origin
# computed there: each map below yields the header value only when an Origin
# was matched, and an empty add_header value is simply not sent — non-browser
# callers (no Origin) receive none of them, like ACAO.
map $cors_origin $cors_allow_methods {
    default 'GET,POST,PUT,DELETE,OPTIONS,HEAD';
    ''      '';
}
map $cors_origin $cors_allow_headers {
    default 'Authorization,Content-Type,X-Permission,X-Expire-Seconds,X-Audience,X-Totp-Code,X-Set-Cookie,X-Target-Host,X-File-Path,X-File-Mode,X-File-User,X-File-Group,X-Send-File-Socket,X-Recv-File-Socket,X-Request-HMAC';
    ''      '';
}
map $cors_origin $cors_expose_headers {
    default 'Content-Type,Content-Disposition,X-Exit-Code,X-Output-Position,X-File-Mode,X-File-User,X-File-Group,X-Subscription-Id,X-Event-Type,X-App-Name';
    ''      '';
}
map $cors_origin $cors_max_age {
    default '86400';
    ''      '';
}

server {
    listen                         443 ssl;
    server_name                    localhost;

    # Hide the nginx version from Server header and error pages
    server_tokens                  off;

    # nginx-generated redirects (the directory 301s, e.g. /appmesh -> /appmesh/)
    # stay relative: the browser keeps the origin it actually used, so a
    # non-default published port (docker -p 8443:443) is no longer dropped and
    # an untrusted Host header is no longer reflected into the Location.
    absolute_redirect              off;

    ssl_certificate                /etc/nginx/conf.d/server.crt;
    ssl_certificate_key            /etc/nginx/conf.d/server.key;
    ssl_protocols                  TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers      on;
    ssl_session_timeout            5m;
    ssl_ciphers                    HIGH:!aNULL:!eNULL:!kECDH:!aDH:!RC4:!3DES:!CAMELLIA:!MD5:!PSK:!SRP:!KRB5:@STRENGTH;
    underscores_in_headers         on;

    # Security headers (aligned with server-side applySecurityHeaders)
    add_header X-Content-Type-Options       "nosniff" always;
    add_header Strict-Transport-Security    "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options              "SAMEORIGIN" always;
    add_header Referrer-Policy              "strict-origin-when-cross-origin" always;
    # CSP: no inline scripts (the hash is the Dex login page's double-submit
    # guard, served same-origin via /auth/ — a daemon template change only
    # drops that guard); inline styles and data:/blob: images for Element Plus.
    add_header Content-Security-Policy      "default-src 'self'; script-src 'self' 'sha256-8L66wXkInDnVEdLxlrsFPaRkqIpBKhVd5kdLxX6AvFk='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # File upload limit control
    client_max_body_size          100m;
    client_body_buffer_size       128k;
    client_body_timeout          120s;

    # charset koi8-r;
    # access_log  /var/log/nginx/host.access.log        main;
    # error_log  /var/log/nginx/error.log               error;

    # Dex login-page logo: frontend.logoURL is issuer-path relative, so the
    # browser resolves it to <origin>/auth/logo.svg whatever host or port it
    # used. Dex has no such route; hand the request to the appmesh backend
    # (the existing /appmesh/ proxy below carries TLS and header settings).
    location = /auth/logo.svg {
        rewrite ^ /appmesh/logo.svg last;
    }

    # Dex hardcodes the login-page favicon to the issuer-relative theme path;
    # the same hand-off serves the appmesh favicon from the backend.
    location = /auth/theme/favicon.png {
        rewrite ^ /appmesh/favicon.png last;
    }

    # Exact-match token endpoint (wins over the /auth/ prefix below);
    # only this path verifies passwords, so only this path is rate limited.
    # The rest of the browser OIDC flow (/auth/auth redirects) stays unlimited.
    location = /auth/token {
        limit_req zone=auth_token burst=5 nodelay;
        limit_req_status 429;
        proxy_pass ${APP_MESH_AUTH_URL};
        proxy_redirect ~^(https?://[^/]+)(/auth/.*)$ $2;
    }

    # Dex issuer path (e.g. /auth/token, /auth/auth) for the browser OIDC flow.
    # 6060 serves the appmesh API only; Dex traffic goes to the authentication
    # service itself (default loopback Dex listener). The same-origin proxy is
    # required: Dex sends no CORS headers and an https page cannot call http.
    # No URI part in proxy_pass: the full /auth/... path is forwarded as-is.
    # Dex builds redirects from its configured issuer (an in-network host the
    # browser cannot reach); rewrite any such absolute /auth URL back to this
    # origin so flows like /auth/device complete behind the proxy.
    location /auth/ {
        proxy_pass ${APP_MESH_AUTH_URL};
        proxy_redirect ~^(https?://[^/]+)(/auth/.*)$ $2;
    }

    # dexuser administration UI (Dex user/client/session/MFA management, served by the
    # dexuser System App on the daemon host, loopback-only by default). Embedded by the
    # Security > Users page under /dexuser/; its HTML uses absolute paths, rewritten here
    # with sub_filter. The admin UI has NO authentication of its own: exposing this
    # location makes user management available to anyone who can reach this origin —
    # keep APP_MESH_ADMIN_UI_URL unreachable in untrusted deployments.
    # Branding: the embedded administration UI ships the Dex glyph; serve the
    # App Mesh logo (the daemon's issuer-path asset) in its place.
    location = /dexuser/static/dex-glyph-color.svg {
        rewrite ^ /appmesh/logo.svg last;
    }

    location /dexuser/ {
        proxy_hide_header X-Frame-Options;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # sub_filter cannot see compressed bodies
        proxy_set_header Accept-Encoding "";
        proxy_redirect ~^/(.*)$ /dexuser/$1;
        sub_filter_once off;
        # text/html is sub_filter_types' built-in default; re-listing it warns
        # "duplicate MIME type" at startup, so only the extra type goes here.
        sub_filter_types text/css;
        sub_filter 'href="/' 'href="/dexuser/';
        sub_filter 'src="/' 'src="/dexuser/';
        sub_filter 'action="/' 'action="/dexuser/';
        sub_filter 'alt="Dex"' 'alt="App Mesh"';
        # The top nav links only the demonstration pages (Flows, Token tools),
        # which use an unregistered OAuth client and cannot work behind this
        # proxy; the administration tabs remain.
        sub_filter '</head>' '<style>.nav{display:none !important}</style></head>';
        sub_filter 'url(/' 'url(/dexuser/';
        # the demo home ("Flows") does an OIDC prompt=none roundtrip with an
        # unregistered client — keep nav inside the admin surface instead
        sub_filter 'href="/dexuser/"' 'href="/dexuser/admin"';
        # Trailing slash: the /dexuser/ prefix is stripped before forwarding
        proxy_pass ${APP_MESH_ADMIN_UI_URL}/;
    }

    # App Mesh 6060 proxy
    location /appmesh/ {
        # Hide server-side CORS headers to avoid duplication
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        # Hide server-side security headers (nginx manages these at server level)
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Strict-Transport-Security;

        # Security headers (must repeat here — nginx add_header inheritance
        # is broken when a location block defines its own add_header)
        add_header X-Content-Type-Options       "nosniff" always;
        add_header Strict-Transport-Security    "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options              "SAMEORIGIN" always;
        add_header Referrer-Policy              "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy      "default-src 'self'; script-src 'self' 'sha256-8L66wXkInDnVEdLxlrsFPaRkqIpBKhVd5kdLxX6AvFk='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

        # CORS - only allow same-origin requests (no external origins).
        # No Origin header means a non-browser caller: it gets no ACAO at all
        # (an empty add_header value is simply not sent) instead of a bogus '*'.
        set $cors_origin '';
        if ($http_origin = "https://$http_host") {
            set $cors_origin $http_origin;
        }
        if ($http_origin = "http://$http_host") {
            set $cors_origin $http_origin;
        }
        add_header 'Access-Control-Allow-Origin' $cors_origin always;
        # Values come from the $cors_origin-derived maps above: empty (not sent)
        # unless the request carried a whitelisted same-origin Origin.
        add_header 'Access-Control-Allow-Methods' $cors_allow_methods always;
        # Allow-Headers: all X-* request headers used by SDK/client
        add_header 'Access-Control-Allow-Headers' $cors_allow_headers always;
        # Expose-Headers: all X-* response headers returned by server
        add_header 'Access-Control-Expose-Headers' $cors_expose_headers always;
        add_header 'Access-Control-Max-Age' $cors_max_age always;

        if ($request_method = 'OPTIONS') {
            return 204;
        }

        # Forward the browser-facing host/scheme so the daemon's CSRF Origin check recognizes
        # same-origin requests (otherwise it sees the upstream Host and would reject the UI).
        # The Go Agent (front proxy on 6060) derives X-Forwarded-Host from the Host header,
        # so Host itself must be the browser-facing host, not the upstream address.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Environment Variable: PROXY_SSL_VERIFY=on/off
        proxy_ssl_verify ${PROXY_SSL_VERIFY};
        proxy_ssl_server_name on;

        proxy_pass ${APP_MESH_API_URL};
    }

    # OAuth redirect target (appmesh-web client): the SPA itself completes the
    # authorization-code exchange from the query string after index.html loads.
    location = /oauth/callback {
        root   /usr/share/nginx/html;
        try_files /index.html =404;
    }

    # Web
    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;

        # allow POST on static pages
        error_page  405     =200 $uri;
    }

    # Liveness endpoint for the container healthcheck. The engine has no
    # dedicated /health route; its unauthenticated index (GET /, "apiIndex") is
    # the liveness equivalent, so the proxy_pass URI pins exactly that path.
    # The location is an exact match: only /health itself is forwarded, and a
    # nested path like /health/x can no longer smuggle a rewritten URI to the
    # engine (the old prefix location turned /health/x into //x, which the
    # engine bounced back with a 301). Headers are pinned instead of taken
    # from the client: the engine trusts X-Forwarded-Host for its same-origin
    # CSRF check, and this unauthenticated location must not become a bypass
    # to forge it. Requests are access-logged like every other proxy target.
    location = /health {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_verify ${PROXY_SSL_VERIFY};
        proxy_ssl_server_name on;
        proxy_pass ${APP_MESH_API_URL}/;
    }

    # A browser that typed http:// against this TLS-only listener gets nginx's
    # raw 497 page ("The plain HTTP request was sent to HTTPS port"). Bounce it
    # to the https URL instead. $bounce_host (map generated by 99-custom-config.sh
    # into 00-bounce-host.conf) echoes $http_host only for whitelisted hosts,
    # keeping a non-default published port (-p 8443:443) without reflecting an
    # arbitrary, client-controlled Host.
    error_page 497 =301 https://$bounce_host$request_uri;

    # error_page  404             /404.html;
    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
