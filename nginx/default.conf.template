server {
    listen                         443 ssl;
    server_name                    localhost;

    ssl_certificate                /etc/nginx/conf.d/server.crt;
    ssl_certificate_key            /etc/nginx/conf.d/server.key;
    ssl_protocols                  TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers      on;
    ssl_session_timeout            5m;
    ssl_ciphers                    HIGH:!aNULL:!eNULL:!kECDH:!aDH:!RC4:!3DES:!CAMELLIA:!MD5:!PSK:!SRP:!KRB5:@STRENGTH;
    underscores_in_headers         on;

    # Security headers (aligned with server-side applySecurityHeaders)
    add_header X-Content-Type-Options       "nosniff" always;
    add_header Strict-Transport-Security    "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options              "SAMEORIGIN" always;
    add_header Referrer-Policy              "strict-origin-when-cross-origin" always;

    # File upload limit control
    client_max_body_size          100m;
    client_body_buffer_size       128k;
    client_body_timeout          120s;

    # charset koi8-r;
    # access_log  /var/log/nginx/host.access.log        main;
    # error_log  /var/log/nginx/error.log               error;

    # Dex login-page logo: frontend.logoURL is issuer-path relative, so the
    # browser resolves it to <origin>/auth/logo.svg whatever host or port it
    # used. Dex has no such route; hand the request to the appmesh backend
    # (the existing /appmesh/ proxy below carries TLS and header settings).
    location = /auth/logo.svg {
        rewrite ^ /appmesh/logo.svg last;
    }

    # Dex hardcodes the login-page favicon to the issuer-relative theme path;
    # the same hand-off serves the appmesh favicon from the backend.
    location = /auth/theme/favicon.png {
        rewrite ^ /appmesh/favicon.png last;
    }

    # Dex issuer path (e.g. /auth/token, /auth/auth) for the browser OIDC flow.
    # 6060 serves the appmesh API only; Dex traffic goes to the authentication
    # service itself (default loopback Dex listener). The same-origin proxy is
    # required: Dex sends no CORS headers and an https page cannot call http.
    # No URI part in proxy_pass: the full /auth/... path is forwarded as-is.
    location /auth/ {
        proxy_pass ${APP_MESH_AUTH_URL};
    }

    # dexuser administration UI (Dex user/client/session/MFA management, served by the
    # dexuser System App on the daemon host, loopback-only by default). Embedded by the
    # Security > Users page under /dexuser/; its HTML uses absolute paths, rewritten here
    # with sub_filter. The admin UI has NO authentication of its own: exposing this
    # location makes user management available to anyone who can reach this origin —
    # keep APP_MESH_ADMIN_UI_URL unreachable in untrusted deployments.
    location /dexuser/ {
        proxy_hide_header X-Frame-Options;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # sub_filter cannot see compressed bodies
        proxy_set_header Accept-Encoding "";
        proxy_redirect ~^/(.*)$ /dexuser/$1;
        sub_filter_once off;
        # text/html is sub_filter_types' built-in default; re-listing it warns
        # "duplicate MIME type" at startup, so only the extra type goes here.
        sub_filter_types text/css;
        sub_filter 'href="/' 'href="/dexuser/';
        sub_filter 'src="/' 'src="/dexuser/';
        sub_filter 'action="/' 'action="/dexuser/';
        sub_filter 'url(/' 'url(/dexuser/';
        # the demo home ("Flows") does an OIDC prompt=none roundtrip with an
        # unregistered client — keep nav inside the admin surface instead
        sub_filter 'href="/dexuser/"' 'href="/dexuser/admin"';
        # Trailing slash: the /dexuser/ prefix is stripped before forwarding
        proxy_pass ${APP_MESH_ADMIN_UI_URL}/;
    }

    # App Mesh 6060 proxy
    location /appmesh/ {
        # Hide server-side CORS headers to avoid duplication
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        # Hide server-side security headers (nginx manages these at server level)
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Strict-Transport-Security;

        # Security headers (must repeat here — nginx add_header inheritance
        # is broken when a location block defines its own add_header)
        add_header X-Content-Type-Options       "nosniff" always;
        add_header Strict-Transport-Security    "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options              "SAMEORIGIN" always;
        add_header Referrer-Policy              "strict-origin-when-cross-origin" always;

        # CORS - only allow same-origin requests (no external origins)
        set $cors_origin '';
        if ($http_origin = '') {
            set $cors_origin '*';
        }
        if ($http_origin = "https://$http_host") {
            set $cors_origin $http_origin;
        }
        if ($http_origin = "http://$http_host") {
            set $cors_origin $http_origin;
        }
        add_header 'Access-Control-Allow-Origin' $cors_origin always;
        add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,DELETE,OPTIONS,HEAD' always;
        # Allow-Headers: all X-* request headers used by SDK/client
        add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,X-Permission,X-Expire-Seconds,X-Audience,X-Totp-Code,X-Set-Cookie,X-Target-Host,X-File-Path,X-File-Mode,X-File-User,X-File-Group,X-Send-File-Socket,X-Recv-File-Socket,X-Request-HMAC' always;
        # Expose-Headers: all X-* response headers returned by server
        add_header 'Access-Control-Expose-Headers' 'Content-Type,Content-Disposition,X-Exit-Code,X-Output-Position,X-File-Mode,X-File-User,X-File-Group,X-Subscription-Id,X-Event-Type,X-App-Name' always;
        add_header 'Access-Control-Max-Age' '86400' always;

        if ($request_method = 'OPTIONS') {
            return 204;
        }

        # Forward the browser-facing host/scheme so the daemon's CSRF Origin check recognizes
        # same-origin requests (otherwise it sees the upstream Host and would reject the UI).
        # The Go Agent (front proxy on 6060) derives X-Forwarded-Host from the Host header,
        # so Host itself must be the browser-facing host, not the upstream address.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Environment Variable: PROXY_SSL_VERIFY=on/off
        proxy_ssl_verify ${PROXY_SSL_VERIFY};
        proxy_ssl_server_name on;

        proxy_pass ${APP_MESH_API_URL};
    }

    # OAuth redirect target (appmesh-web client): the SPA itself completes the
    # authorization-code exchange from the query string after index.html loads.
    location = /oauth/callback {
        root   /usr/share/nginx/html;
        try_files /index.html =404;
    }

    # Web
    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;

        # allow POST on static pages
        error_page  405     =200 $uri;
    }

    location /health {
        access_log off;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_pass ${APP_MESH_API_URL}/;
    }

    # A browser that typed http:// against this TLS-only listener gets nginx's
    # raw 497 page ("The plain HTTP request was sent to HTTPS port"). Bounce it
    # to the https URL instead. $http_host (not $host) keeps a non-default
    # published port, so a -p 8443:443 mapping still redirects where it should.
    error_page 497 =301 https://$http_host$request_uri;

    # error_page  404             /404.html;
    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
